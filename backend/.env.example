NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# URL-encode special characters in the username/password. Use a dedicated DB user.
MYSQL_URL=mysql://workbench_user:replace_me@localhost:3306/document_workbench
# Production: use Railway's public TCP proxy URL ending in /document_workbench.
# Render injects MYSQL_URL and other secrets through backend environment variables.
# Mount a persistent Render disk here, then set UPLOAD_DIR=/var/data/uploads.
# UPLOAD_DIR=/var/data/uploads

# mock = deterministic labelled-field extraction and literal comparisons.
# gemini = structured AI extraction/comparison with labelled rule-based fallback.
AI_MODE=mock
# Local: backend/.env. Production: Render environment. Never put this key in the frontend.
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Example model ID; replace with a model available to your Google account.
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODEL is the intended spelling (not GRMINI_MODEL).
